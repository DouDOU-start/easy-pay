# Easy-Pay 本地开发环境变量 — 单一真理来源
#
# 用法：cp .env.example .env，按需修改后重新 `make dev`
# - docker compose 自动读取 .env
# - Makefile 的 dev / run 目标会把 .env 注入到 go 进程
# - viper 与首装向导（setup.go + Setup.tsx）通过 internal/pkg/defaults 读取这些值
#
# 端口冲突时只改这里，不要再去翻 docker-compose.yml / configs/config.yaml。

# Postgres：宿主机暴露端口（容器内仍是 5432）
EASYPAY_DB_PORT=5432

# Redis：宿主机暴露端口（容器内仍是 6379）
EASYPAY_REDIS_PORT=6379
# 连远程 Redis 时改 HOST，默认 localhost
# EASYPAY_REDIS_HOST=localhost
# EASYPAY_REDIS_PASSWORD=
# EASYPAY_REDIS_DB=0

# 数据库账号 — compose、应用、首装向导默认值都读这里
# 注意：改 USER/PASSWORD/NAME 后若 postgres_data 卷已初始化，旧账号仍生效，
# 需先 `docker compose down -v` 清卷再起。
# EASYPAY_DB_HOST=localhost
# EASYPAY_DB_USER=easypay
# EASYPAY_DB_PASSWORD=easypay
# EASYPAY_DB_NAME=easypay
